{
  "manifest_version": 3,
  "name": "Abacus Mental Math Helper",
  "version": "1.0",
  "description": "Hide the timer, cap wrong answers at two, and add a play-again button on client.abacusmentalmath.com.",
  "permissions": ["storage"],
  "host_permissions": ["https://client.abacusmentalmath.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abacus Mental Math Helper"
  },
  "content_scripts": [
    {
      "matches": ["https://client.abacusmentalmath.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
